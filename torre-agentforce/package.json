{
  "name": "torre-agentforce",
  "version": "1.0.0",
  "private": true,
  "description": "Torre Agentforce Zapata — hospeda el Agente Postventa contra la org real de Salesforce",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:frontend && npm run typecheck",
    "build:css": "node scripts/build-frontend.mjs --css-only",
    "build:frontend": "node scripts/build-frontend.mjs",
    "predev": "npm run build:frontend",
    "dev": "node --experimental-strip-types --watch src/servidor/index.ts",
    "prestart": "npm run build:frontend",
    "start": "npm run start:server",
    "start:server": "node --env-file-if-exists=.env --experimental-strip-types src/servidor/index.ts",
    "typecheck": "tsc --noEmit",
    "esquema": "node scripts/describe-objetos.mjs",
    "verificar:datos": "node --env-file-if-exists=.env --experimental-strip-types --input-type=module -e \"process.env.APP_ENV='development'; process.env.APP_AUTH_PROVIDER='disabled'; process.env.APP_AUTH_MODE='disabled'; await import('./scripts/verificar-datos.ts')\"",
    "verificar:agent-api": "node --env-file-if-exists=.env --experimental-strip-types --input-type=module -e \"process.env.APP_ENV='development'; process.env.APP_AUTH_PROVIDER='disabled'; process.env.APP_AUTH_MODE='disabled'; await import('./scripts/verificar-agent-api.ts')\"",
    "preverificar:escalamiento-agentforce": "node --experimental-strip-types --check scripts/verificar-escalamiento-agentforce.ts",
    "verificar:escalamiento-agentforce": "node --env-file-if-exists=.env --experimental-strip-types --input-type=module -e \"process.env.APP_ENV='development'; process.env.APP_AUTH_PROVIDER='disabled'; process.env.APP_AUTH_MODE='disabled'; await import('./scripts/verificar-escalamiento-agentforce.ts')\"",
    "preverificar:diseno": "npm run build:frontend",
    "verificar:diseno": "node scripts/verificar-diseno.mjs",
    "test": "npm run test:unit && npm run test:agent-protocol && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --test tests/security/auth-ansi.test.ts tests/security/config.test.ts tests/security/evidence-and-logs.test.ts tests/security/oidc.test.ts tests/security/oidc-config.test.ts tests/security/oidc-server.test.ts tests/security/security.test.ts tests/security/superficie-cliente.test.ts tests/security/deteccion-escalamiento.test.ts tests/security/server.test.ts tests/security/shutdown.test.ts tests/escalamiento-apex.test.ts tests/verificar-escalamiento-agentforce.test.ts tests/vin-mencionado.test.ts tests/sucursal-mencionada.test.ts tests/version-acredita.test.ts tests/procedencia.test.ts tests/compuerta-modelo.test.ts tests/contraste-sistema.test.ts tests/eleccion-regla.test.ts tests/identidad-org.test.ts tests/dia-de-la-franja.test.ts",
    "test:agent-protocol": "node --experimental-strip-types scripts/prueba-protocolo-agente.ts",
    "pretest:e2e": "npm run build:frontend",
    "test:e2e": "playwright test",
    "pretest:e2e:api": "npm run build:frontend",
    "test:e2e:api": "playwright test tests/e2e/business-contracts.spec.ts tests/e2e/resource-ownership.spec.ts tests/e2e/security.spec.ts tests/e2e/chat-lifecycle.spec.ts --project=api-and-ui",
    "pretest:e2e:ui": "npm run build:frontend",
    "test:e2e:ui": "playwright test tests/e2e/sitio-cliente.spec.ts tests/e2e/csp.spec.ts --project=api-and-ui",
    "pretest:e2e:mutating": "npm run build:frontend",
    "test:e2e:mutating": "playwright test tests/e2e/mutating-escalation.spec.ts --project=api-and-ui",
    "test:e2e:install": "playwright install chromium",
    "diagramas": "node --experimental-strip-types scripts/generar-diagramas.ts",
    "verificar:rutas": "node --env-file-if-exists=.env --experimental-strip-types --input-type=module -e \"process.env.APP_ENV='development'; process.env.APP_AUTH_PROVIDER='disabled'; process.env.APP_AUTH_MODE='disabled'; await import('./scripts/verificar-rutas.mjs')\"",
    "verificar:escalamiento-e2e": "node --env-file-if-exists=.env --experimental-strip-types --input-type=module -e \"process.env.APP_ENV='development'; process.env.APP_AUTH_PROVIDER='disabled'; process.env.APP_AUTH_MODE='disabled'; await import('./scripts/prueba-escalamiento-e2e.mjs')\"",
    "sitio": "npm run build:frontend && node --env-file-if-exists=.env --experimental-strip-types scripts/sitio.mjs",
    "verificar:credencial": "node --env-file-if-exists=.env scripts/verificar-credencial.mjs",
    "verificar:e2e": "node --env-file-if-exists=.env scripts/verificar-e2e.mjs",
    "preverificar:guion": "npm run build:frontend",
    "verificar:guion": "node --env-file-if-exists=.env scripts/verificar-guion.mjs",
    "agenda:extender": "node --env-file-if-exists=.env scripts/extender-agenda.mjs",
    "verificar:generalidad": "node --env-file-if-exists=.env scripts/verificar-generalidad.mjs"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.9.0",
    "mermaid": "^11.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
