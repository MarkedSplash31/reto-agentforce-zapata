# Torre Agentforce Zapata — variables de entorno
#
# Copia este archivo a `.env` y llena los valores. `.env` está en .gitignore.
# NINGÚN secreto entra al repositorio ni a un log. El servidor lee de process.env;
# `npm start` carga un `.env` local si existe. En hosting, inyecta los valores con
# el gestor de secretos de la plataforma; nunca subas ese archivo al repositorio.
#
# La External Client App `Torre Agentforce Zapata` ya existe y está activa. Tras la
# rotación/reautenticación de BLOQUEOS.md §0, un humano recupera los dos valores
# marcados SECRETO y los pega sólo en el `.env` local/secret store.
# Para identidad individual debe tener exactamente estos scopes: openid, api,
# refresh_token/offline_access, chatbot_api y sfap_api. Si `openid` o el callback
# no están configurados en la ECA, producción falla cerrada y no usa Bearer.

# ─── Org ────────────────────────────────────────────────────────────────────
# My Domain de la org. NO uses login.salesforce.com.
SF_LOGIN_URL=https://orgfarm-1c6625ec2e-dev-ed.develop.my.salesforce.com
SF_API_VERSION=v67.0

# ─── Credenciales de la External Client App (client credentials) ────────────
# SECRETO. Requeridos para producción y para la sección Conversación (Agent API).
# Configuración → External Client Apps → Torre Agentforce Zapata → Clave y secreto de consumidor
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ─── Agente ─────────────────────────────────────────────────────────────────
# BotDefinition.Id de Agente_Postventa_Zapata, confirmado por SOQL el 5-ago-2026.
SF_AGENT_ID=0XxgK0000022RhJSAU
SF_AGENT_API_HOST=https://api.salesforce.com

# ─── Escalamiento ───────────────────────────────────────────────────────────
# Cola Escalamiento_Postventa, confirmada por SOQL sobre Group.
SF_COLA_ESCALAMIENTO_ID=00GgK00000BMTaVUAX
# Frontera de autorización de Cases para el rol asesor. Mantener separada de la
# configuración funcional aunque hoy apunte a la misma Queue (prefijo 00G).
SF_CASE_QUEUE_ID=00GgK00000BMTaVUAX

# ─── Servidor ───────────────────────────────────────────────────────────────
# Render inyecta PORT; el valor siguiente sólo es el default local.
PORT=3000
NODE_ENV=development
APP_ENV=development

# ─── Identidad de entrada ───────────────────────────────────────────────────
# `oidc`     → producción: identidad individual Salesforce, cookie HttpOnly.
# `static`   → únicamente QA controlado; nunca tiene precedencia sobre OIDC.
# `disabled` → sólo desarrollo local; producción lo rechaza.
APP_AUTH_PROVIDER=disabled

# Compatibilidad transitoria. Debe ser `required` para oidc/static y `disabled`
# para disabled; si contradice APP_AUTH_PROVIDER el proceso no arranca.
APP_AUTH_MODE=disabled

# Producción con `static` exige además APP_STATIC_QA_ENABLED=true. No definir en
# un runtime OIDC.
APP_STATIC_QA_ENABLED=

# QA static: este secreto debe ser un JSON no vacío.
# Esquema para asesor/admin: [{"id":"identidad-estable","role":"asesor|admin","token":"minimo-32-bytes"}]
# Un cliente exige además `bindings` con al menos un Id real autorizado, por ejemplo
# `contactIds`, `accountIds`, `assetIds` o `workOrderIds`; el servidor valida sus
# prefijos y aplica esos vínculos a las consultas Salesforce. No inventes IDs.
# El token estático es sólo un respaldo controlado de QA; la interfaz pública debe
# usar identidad individual OIDC. No pongas tokens de ejemplo en el repositorio.
APP_AUTH_CREDENTIALS_JSON=

# ─── Salesforce OAuth/OIDC BFF ──────────────────────────────────────────────
# Requeridos sólo con APP_AUTH_PROVIDER=oidc. No inventes el dominio de hosting:
# configúralos después de crear el servicio y registra el mismo callback exacto
# en la External Client App.
APP_EXTERNAL_ORIGIN=
APP_OIDC_CALLBACK_URL=

# Hostnames Salesforce exactos a los que el BFF puede enviar un Bearer. Sin
# protocolo, path ni comodines. Agrega el instance_url real sólo si difiere.
SF_OIDC_ALLOWED_HOSTS=orgfarm-1c6625ec2e-dev-ed.develop.my.salesforce.com

# Issuer exacto confirmado mediante discovery real del My Domain. No se aceptan
# sufijos ni comodines.
SF_OIDC_EXPECTED_ISSUERS=https://orgfarm-1c6625ec2e-dev-ed.develop.my.salesforce.com

# Debe coincidir con los scopes habilitados externamente en la ECA.
SF_OIDC_SCOPES=openid,api,refresh_token,chatbot_api,sfap_api

# Permission Sets reales de la org. Admin está asignado sólo a Gabriel; Asesor
# se asigna individualmente a usuarios asesores, nunca por dato del navegador.
APP_OIDC_ADMIN_PERMISSION_SETS=Torre_Agentforce_Admin
APP_OIDC_ADVISOR_PERMISSION_SETS=Torre_Agentforce_Asesor

APP_OIDC_SESSION_TTL_MS=28800000
APP_OIDC_AUTH_TTL_MS=300000
APP_OIDC_MAX_SESSIONS=10000
APP_OIDC_MAX_AUTH_ATTEMPTS=2000

# Origins adicionales exactos, separados por coma. En producción sólo HTTPS.
# Para frontend same-origin puede quedar vacío.
APP_CORS_ORIGINS=

# IPs exactas de proxies confiables, separadas por coma. Vacío ignora X-Forwarded-For.
# No usar `*`, `true`, rangos ni una IP inferida; confirmar el peer inmediato del host.
APP_TRUST_PROXY=

# Límites y timeouts. Los defaults siguientes están validados por el servidor.
APP_RATE_LIMIT_WINDOW_MS=60000
APP_RATE_LIMIT_MAX=120
APP_AUTH_RATE_LIMIT_MAX=20
APP_BODY_LIMIT_BYTES=65536
APP_REQUEST_TIMEOUT_MS=30000
APP_SHUTDOWN_TIMEOUT_MS=10000
SF_REQUEST_TIMEOUT_MS=20000
SF_CLI_TIMEOUT_MS=30000
AGENT_API_TIMEOUT_MS=30000

# Identificador no secreto mostrado por /salud para correlacionar el build.
APP_BUILD_ID=local

# ─── Proveedor de token ─────────────────────────────────────────────────────
# `client_credentials` → producción. Requiere SF_CLIENT_ID y SF_CLIENT_SECRET.
# `cli`                → desarrollo local. Toma el token del `sf` CLI ya
#                        autenticado contra el alias de abajo. Habilita SOQL y
#                        Flows contra la org REAL, pero NO la Agent API.
# La imagen Docker no incluye `sf`; dentro del contenedor usa client_credentials.
SF_TOKEN_PROVIDER=cli
SF_CLI_ORG_ALIAS=zapata
