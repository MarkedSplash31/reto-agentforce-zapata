<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Proximo_Servicio_Km__c</fullName>
    <description>Formula: kilometraje en el que corresponde el siguiente servicio preventivo (cada 10,000 km).</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Km_Ultimo_Servicio__c), 10000, Km_Ultimo_Servicio__c + 10000)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Proximo servicio (km)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
