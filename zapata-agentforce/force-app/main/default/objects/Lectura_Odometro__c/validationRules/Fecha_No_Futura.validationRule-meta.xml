<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fecha_No_Futura</fullName>
    <active>true</active>
    <errorConditionFormula>Fecha_Lectura__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Fecha_Lectura__c</errorDisplayField>
    <errorMessage>No se puede registrar una lectura de odometro con fecha futura.</errorMessage>
</ValidationRule>
