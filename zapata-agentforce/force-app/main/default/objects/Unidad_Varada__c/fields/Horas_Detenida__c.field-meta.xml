<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Horas_Detenida__c</fullName>
    <description>Horas que lleva o llevo detenida. Es la metrica de negocio que traduce el problema a dinero.</description>
    <label>Horas detenida</label>
    <formula>IF( ISBLANK(Fecha_Resolucion__c), (NOW() - Fecha_Reporte__c) * 24, (Fecha_Resolucion__c - Fecha_Reporte__c) * 24 )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <scale>0</scale>
    <type>Number</type>
</CustomField>
