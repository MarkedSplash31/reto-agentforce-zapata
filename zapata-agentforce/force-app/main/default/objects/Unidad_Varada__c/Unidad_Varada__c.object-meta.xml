    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Zapata_Resumen</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Reporte de una unidad inmovilizada en carretera. Es el dolor mas caro del cliente: cada hora detenida es perdida directa. Lo alimenta el subagente Atencion de Unidades Varadas.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
