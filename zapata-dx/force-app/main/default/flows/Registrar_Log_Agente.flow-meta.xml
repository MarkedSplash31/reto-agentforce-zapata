<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Poner_Codigo_Generico</name>
        <label>Poner codigo generico</label>
        <locationX>50</locationX>
        <locationY>408</locationY>
        <assignmentItems>
            <assignToReference>varErrorCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SIN_CODIGO_REPORTADO</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Crear_Log</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Falta_Codigo_De_Error</name>
        <label>Falta codigo de error</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnector>
            <targetReference>Crear_Log</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No falta</defaultConnectorLabel>
        <rules>
            <name>Si_falta</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>frmOutcome</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ERROR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>frmOutcome</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BLOCKED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varErrorCode</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varGuardrail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Poner_Codigo_Generico</targetReference>
            </connector>
            <label>Si falta</label>
        </rules>
    </decisions>
    <description>Subflow de trazabilidad. Plan seccion 8.2: todos los Flows de negocio lo invocan dentro de la misma ruta de exito o de error. Escribe un Log_Agente__c y devuelve su Id. Rellena solo el momento del evento y el actor; todo lo demas lo pasa quien lo llama.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmActor</name>
        <dataType>String</dataType>
        <expression>IF( ISBLANK({!varActor}), {!$User.Username}, {!varActor} )</expression>
    </formulas>
    <formulas>
        <name>frmOutcome</name>
        <dataType>String</dataType>
        <expression>IF( ISBLANK({!varOutcome}), &quot;SUCCESS&quot;, {!varOutcome} )</expression>
    </formulas>
    <formulas>
        <name>frmTimestamp</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Registrar Log Agente {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Registrar Log Agente</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
