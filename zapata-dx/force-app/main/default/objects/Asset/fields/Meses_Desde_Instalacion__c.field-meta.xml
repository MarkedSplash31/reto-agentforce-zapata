<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Meses_Desde_Instalacion__c</fullName>
    <description>Meses cumplidos desde la instalacion. Es un hecho calculado, no un dato que alguien pueda dejar viejo. La accion lo compara contra Meses_Limite__c.</description>
    <externalId>false</externalId>
    <formula>(YEAR(TODAY()) - YEAR(InstallDate)) * 12 + (MONTH(TODAY()) - MONTH(InstallDate)) - IF(DAY(TODAY()) &lt; DAY(InstallDate), 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Meses desde instalacion</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
