<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Requiere_Fuente_Knowledge</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Resultado__c, &quot;RESUELTO_SIN_CITA&quot;), ISBLANK(Knowledge_Article_Id__c))</errorConditionFormula>
    <errorDisplayField>Knowledge_Article_Id__c</errorDisplayField>
    <errorMessage>No se puede cerrar un caso sin cita sin citar el articulo que lo sustenta.</errorMessage>
</ValidationRule>
